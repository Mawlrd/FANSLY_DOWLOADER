{
  "manifest_version": 3,
  "name": "Descargar video a MP4",
  "short_name": "Video a MP4",
  "version": "1.0.0",
  "description": "Detecta el video de la página (HLS / m3u8), baja sus pedazos y te deja un solo archivo .mp4 en Descargas.",
  "permissions": ["scripting", "downloads", "storage", "webNavigation", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["detector.js"],
      "all_frames": true,
      "run_at": "document_start",
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Descargar video a MP4",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
